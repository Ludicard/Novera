# Copia este archivo a .env y completa los valores (cp .env.example .env)

# Dominio que apunta a la IP del VPS (Caddy obtiene el certificado HTTPS solo)
DOMAIN=novera.midominio.com

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=novera.midominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://novera.midominio.com

# Base de datos (usa solo letras y números en la contraseña)
POSTGRES_DB=novera
POSTGRES_USER=novera
POSTGRES_PASSWORD=cambia-esta-contrasena

# Serie SRI de las facturas: establecimiento-punto de emisión
NOVERA_SERIE_FACTURA=001-001
